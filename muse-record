# BLE session
# ---------------------------------------------------------------------------

def is_muse(device, adv) -> bool:
    name = device.name or (adv.local_name if adv else None) or ""
    uuids = [u.lower() for u in (adv.service_uuids if adv else [])]
    return name.lower().startswith("muse") or MUSE_SERVICE in uuids


async def find_muses(timeout: float) -> list:
    found = await BleakScanner.discover(timeout=timeout, return_adv=True)
    return [(d, a) for d, a in found.values() if is_muse(d, a)]


async def resolve_device(address: Optional[str], timeout: float, name: Optional[str] = None):
    if name:
        log(f"scanning up to {timeout:.0f}s for '{name}' ...")
        dev = await BleakScanner.find_device_by_filter(
            lambda d, a: is_muse(d, a) and name in (d.name, a.local_name if a else None)
            and (not address or d.address == address), timeout=timeout)
        if dev is None:
            raise SystemExit(
                f"[muse-record] '{name}' not found -- is the headband on (LED "
                "blinking) and not connected to a phone/another program?")
        return dev
    if address:
        dev = await BleakScanner.find_device_by_address(address, timeout=timeout)
        if dev is None:
            raise SystemExit(
                f"[muse-record] {address} not found -- is the headband on (LED "
                "blinking) and not connected to a phone/another program?")
        return dev
    log(f"scanning up to {timeout:.0f}s for a Muse headband ...")
    dev = await BleakScanner.find_device_by_filter(is_muse, timeout=timeout)
    if dev is None:
        raise SystemExit(
            "[muse-record] no Muse headband found -- turn it on (LED blinking), "
            "make sure no phone/app is connected to it, and retry (see README)")
    return dev


async def send(client: BleakClient, cmd: str) -> None:
    await client.write_gatt_char(CONTROL_UUID, encode_command(cmd), response=False)


async def run(args) -> int:
    if args.scan:
        for d, a in await find_muses(args.scan_timeout):
            print(f"{d.address}\t{d.name or a.local_name}\t{a.rssi} dBm")
        return 0

    device = await resolve_device(args.address, args.scan_timeout, args.name)
    log(f"connecting to {device.name} ({device.address}) ...")

    out: Optional[TextIO]
    outlet = None
    if args.lsl:
        out = None
        outlet = make_outlet(args.lsl_name, device, args.include_seq or args.include_raw_bytes)
    elif args.output in (None, "-"):
        out = sys.stdout
    else:
        out = open(args.output, "w", buffering=1 << 16, newline="")
    writer = OrderedCSVWriter(out, int(args.reorder_latency * 1e9), args.include_raw_bytes,
                              args.include_seq or args.include_raw_bytes, outlet)
    rec = Recorder(writer, verbose=args.verbose)

    disconnected = asyncio.Event()
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for s in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(s, stop.set)

    client = BleakClient(device, disconnected_callback=lambda _c: disconnected.set())
    for attempt in range(1, 4):
        try:
            await client.connect(timeout=20.0)
            break
        except Exception as e:
            log(f"connect attempt {attempt} failed: {e!r}")
            if attempt == 3:
                raise SystemExit("[muse-record] could not connect (see README, 'Connecting')")
            await asyncio.sleep(2)

    exit_code = 0
    try:
        chars = {c.uuid.lower(): c for s in client.services for c in s.characteristics}
        if ATHENA_UUID in chars and _uuid(0x0003) not in chars:
            raise SystemExit(
                "[muse-record] this is a Muse S Athena (gen 3) headband, which "
                "uses a different BLE protocol that muse-record does not decode yet")
        has_ppg = all(u in chars for u in PPG_UUIDS)
        preset = args.preset or ("p50" if has_ppg else "p20")

        wanted = [CONTROL_UUID]
        if not args.skip_eeg:
            wanted += list(EEG_UUIDS)
        if not args.skip_acc:
            wanted.append(ACC_UUID)
        if not args.skip_gyro:
            wanted.append(GYRO_UUID)
        if not args.skip_telemetry:
            wanted.append(TELEMETRY_UUID)
        if not args.skip_drlref:
            wanted.append(DRLREF_UUID)
        if not args.skip_ppg and has_ppg:
            wanted += list(PPG_UUIDS)
        if args.include_raw_bytes:
            known = {CONTROL_UUID, DRLREF_UUID, ACC_UUID, GYRO_UUID, TELEMETRY_UUID, *EEG_UUIDS, *PPG_UUIDS}
            wanted += [u for u, c in chars.items()
                       if u.startswith("273e") and u not in known and "notify" in c.properties]
        missing = [u for u in wanted if u not in chars]
        for u in missing:
            log(f"note: characteristic {u[4:8]} not present on this headband, skipping")
        wanted = [u for u in wanted if u in chars]

        await send(client, "h")  # halt any previous streaming
        await asyncio.sleep(0.1)
        for u in wanted:
            await client.start_notify(u, rec.handler(u))
        if args.verbose:
            log("subscribed to: " + ", ".join(u[4:8] for u in wanted))
        await send(client, "v1")  # device/firmware info (logged to stderr)
        await asyncio.sleep(0.3)
        log(f"selecting preset {preset}")
        await send(client, preset)
        await asyncio.sleep(0.1)
        await send(client, "s")  # status: serial, battery, preset (stderr)
        await asyncio.sleep(0.3)
        await send(client, "d")  # start streaming
        log("recording; Ctrl+C to stop")

        if args.info:
            await asyncio.sleep(2.0)
            stop.set()

        t_start = time.monotonic()
        next_keepalive = t_start + KEEPALIVE_S
        rec.last_data_ns = time.time_ns()
        while not stop.is_set() and not disconnected.is_set():
            try:
                await asyncio.wait_for(stop.wait(), timeout=0.05)
            except asyncio.TimeoutError:
                pass
            writer.flush()
            now = time.monotonic()
            if args.duration and now - t_start >= args.duration:
                break
            if now >= next_keepalive:
                next_keepalive = now + KEEPALIVE_S
                try:
                    await send(client, "k")
                except Exception as e:
                    log(f"keep-alive failed: {e!r}")
            if time.time_ns() - rec.last_data_ns > NO_DATA_TIMEOUT_S * 1e9:
                log(f"no data for {NO_DATA_TIMEOUT_S:.0f}s, re-sending start command")
                rec.last_data_ns = time.time_ns()
                await send(client, "d")
        if disconnected.is_set():
            log("headband disconnected")
            exit_code = 1
    except BrokenPipeError:
        # the consumer (e.g. live-viewer) went away; silence further writes
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    finally:
        try:
            if client.is_connected:
                await send(client, "h")
                await client.disconnect()
        except Exception:
            pass
        try:
            rec.flush_all()
            if out is not None and out is not sys.stdout:
                out.close()
        except BrokenPipeError:
            pass
        summary = ", ".join(f"{k} {v}" for k, v in sorted(writer.per_stream.items()))
        log(f"stopped; rows written: {writer.rows} ({summary or 'none'}); "
            f"lost packets: {rec.lost_summary()}"
            + (f"; {writer.clamped} late rows clamped" if writer.clamped else ""))
    return exit_code


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--address", help="BLE address of the headband (default: the first Muse found)")
    p.add_argument("--name", help="Bluetooth name of the headband, e.g. Muse-861D (default: the first Muse found)")
    p.add_argument("--scan", action="store_true", help="list nearby Muse headbands and exit")
    p.add_argument("--scan-timeout", type=float, default=10.0, help="seconds to scan (default 10)")
    p.add_argument("--info", action="store_true",
                   help="connect, print device info/status to stderr, record ~2s, exit")
    p.add_argument("-o", "--output", default="-", help="output CSV file (default: stdout)")
    p.add_argument("--lsl", action="store_true",
                   help="publish to a Lab Streaming Layer outlet instead of writing CSV (needs pylsl)")
    p.add_argument("--lsl-name", default=LSL_STREAM_NAME,
                   help=f"LSL stream name (default {LSL_STREAM_NAME}); give each headband its own")
    p.add_argument("--duration", type=float, default=None, help="stop after this many seconds")
    p.add_argument("--preset", default=None,
                   help="headband preset command, e.g. p20 (4 EEG + AUX), p21 (4 EEG), "
                        "p50 (EEG + PPG); default: p50 if the headband has PPG, else p20")
    p.add_argument("--skip-eeg", action="store_true", help="do not record EEG")
    p.add_argument("--skip-acc", action="store_true", help="do not record the accelerometer")
    p.add_argument("--skip-gyro", action="store_true", help="do not record the gyroscope")
    p.add_argument("--skip-ppg", action="store_true", help="do not record PPG")
    p.add_argument("--skip-drlref", action="store_true", help="do not record the DRL/REF electrodes")
    p.add_argument("--skip-telemetry", action="store_true", help="do not record battery/telemetry")
    p.add_argument("--include-seq", action="store_true",
                   help="add a seq column: the headband's 16-bit packet counter of each row")
    p.add_argument("--include-raw-bytes", action="store_true",
                   help="add a raw_hex column with the verbatim BLE packet(s) of each row "
                        "(first row of each packet; implies --include-seq), and also record "
                        "any other notifying Muse characteristic without a decoder")
    p.add_argument("--reorder-latency", type=float, default=0.5,
                   help="seconds rows are held back to be emitted in time order (default 0.5)")
    p.add_argument("--verbose", "-v", action="store_true", help="extra diagnostics on stderr")
    args = p.parse_args()
    try:
        sys.exit(asyncio.run(run(args)))
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()
